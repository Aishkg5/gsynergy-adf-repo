{
	"name": "df_site",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_adls",
						"type": "DatasetReference"
					},
					"name": "adlsposite"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "chnlselect"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          site_id as string,",
				"          site_label as string,",
				"          subchnl_id as string,",
				"          subchnl_label as string,",
				"          chnl_id as string,",
				"          chnl_label as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false) ~> adlsposite",
				"adlsposite select(mapColumn(",
				"          chnl_id,",
				"          chnl_label",
				"     ),",
				"     partitionBy('hash', 1),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> chnlselect",
				"chnlselect aggregate(groupBy(chnl_id),",
				"     chnl_label = first(chnl_label)) ~> aggregate1"
			]
		}
	}
}