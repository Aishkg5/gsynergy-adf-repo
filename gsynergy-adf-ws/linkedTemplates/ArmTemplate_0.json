{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "gsynergy-adf-ws"
		},
		"ls_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls'"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsgsynergy.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_adls')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_adls_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('ls_adls_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_adls')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_adls",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_ds_container": {
						"type": "string"
					},
					"p_ds_file_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().p_ds_file_name",
							"type": "Expression"
						},
						"fileSystem": {
							"value": "@dataset().p_ds_container",
							"type": "Expression"
						}
					},
					"columnDelimiter": "|",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_adls')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_adls_parquet')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_adls",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"ds_sink_fn": {
						"type": "string"
					},
					"p_ds_sink_container": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"folderPath": {
							"value": "@dataset().ds_sink_fn",
							"type": "Expression"
						},
						"fileSystem": "oltpraw"
					},
					"compressionCodec": "snappy"
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_adls')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_loc')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_adls",
								"type": "DatasetReference"
							},
							"name": "invlocadls"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "loctable"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "loctypetable"
						}
					],
					"transformations": [
						{
							"name": "locselect"
						},
						{
							"name": "loctypeselect"
						},
						{
							"name": "distinctloctype"
						}
					],
					"scriptLines": [
						"source(output(",
						"          loc as short,",
						"          loc_label as string,",
						"          loctype as string,",
						"          loctype_label as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     inferDriftedColumnTypes: true,",
						"     ignoreNoFilesFound: false,",
						"     partitionBy('hash', 1)) ~> invlocadls",
						"invlocadls select(mapColumn(",
						"          loc,",
						"          loc_label,",
						"          loctype",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> locselect",
						"invlocadls select(mapColumn(",
						"          loctype,",
						"          loctype_label",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> loctypeselect",
						"loctypeselect aggregate(groupBy(loctype),",
						"     loctype_label = first(loctype_label)) ~> distinctloctype",
						"locselect sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> loctable",
						"distinctloctype sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> loctypetable"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_adls')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_parquet')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_pricestate')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_adls",
								"type": "DatasetReference"
							},
							"name": "adlsPricestate"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "statesink"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "substatesink"
						}
					],
					"transformations": [
						{
							"name": "substate"
						},
						{
							"name": "state"
						}
					],
					"scriptLines": [
						"source(output(",
						"          substate_id as string,",
						"          substate_label as string,",
						"          state_id as string,",
						"          state_label as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     inferDriftedColumnTypes: true,",
						"     ignoreNoFilesFound: false,",
						"     partitionBy('hash', 1),",
						"     mode: 'read') ~> adlsPricestate",
						"adlsPricestate select(mapColumn(",
						"          substate_id,",
						"          substate_label,",
						"          state_id",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> substate",
						"adlsPricestate aggregate(groupBy(state_id),",
						"     state_label = first(state_label),",
						"     partitionBy('hash', 1)) ~> state",
						"state sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> statesink",
						"substate sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> substatesink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_adls')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_parquet')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_prod')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_adls",
								"type": "DatasetReference"
							},
							"name": "adlsprod"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "stylclrtable"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "prodtable"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "styletable"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "subcattable"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "catgtable"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "depttable"
						}
					],
					"transformations": [
						{
							"name": "product"
						},
						{
							"name": "DistinctStylclr"
						},
						{
							"name": "stylclrselect"
						},
						{
							"name": "styleselect"
						},
						{
							"name": "distinctStyl"
						},
						{
							"name": "subcatselect"
						},
						{
							"name": "distinctsubcat"
						},
						{
							"name": "catselect"
						},
						{
							"name": "ditsinctCatg"
						},
						{
							"name": "deptselect"
						},
						{
							"name": "distinctDept"
						}
					],
					"scriptLines": [
						"source(output(",
						"          sku_id as string,",
						"          sku_label as string,",
						"          stylclr_id as string,",
						"          stylclr_label as string,",
						"          styl_id as string,",
						"          styl_label as string,",
						"          subcat_id as short,",
						"          subcat_label as string,",
						"          cat_id as short,",
						"          cat_label as string,",
						"          dept_id as short,",
						"          dept_label as string,",
						"          issvc as boolean,",
						"          isasmbly as boolean,",
						"          isnfs as boolean",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     inferDriftedColumnTypes: true,",
						"     ignoreNoFilesFound: false) ~> adlsprod",
						"adlsprod select(mapColumn(",
						"          sku_id,",
						"          sku_label,",
						"          stylclr_id,",
						"          issvc,",
						"          isasmbly,",
						"          isnfs",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> product",
						"stylclrselect aggregate(groupBy(stylclr_id),",
						"     each(match(name!='stylclr_id'), $$ = first($$))) ~> DistinctStylclr",
						"adlsprod select(mapColumn(",
						"          stylclr_id,",
						"          stylclr_label,",
						"          styl_id",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> stylclrselect",
						"adlsprod select(mapColumn(",
						"          styl_id,",
						"          styl_label,",
						"          subcat_id",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> styleselect",
						"styleselect aggregate(groupBy(styl_id),",
						"     each(match(name!='styl_id'), $$ = first($$))) ~> distinctStyl",
						"adlsprod select(mapColumn(",
						"          subcat_id,",
						"          subcat_label,",
						"          cat_id",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> subcatselect",
						"subcatselect aggregate(groupBy(subcat_id),",
						"     each(match(name!='subcat_id'), $$ = first($$))) ~> distinctsubcat",
						"adlsprod select(mapColumn(",
						"          cat_id,",
						"          cat_label,",
						"          dept_id",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> catselect",
						"catselect aggregate(groupBy(cat_id),",
						"     each(match(name!='cat_id'), $$ = first($$))) ~> ditsinctCatg",
						"adlsprod select(mapColumn(",
						"          dept_id,",
						"          dept_label",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> deptselect",
						"deptselect aggregate(groupBy(dept_id),",
						"     dept_label = first(dept_label)) ~> distinctDept",
						"DistinctStylclr sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> stylclrtable",
						"product sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> prodtable",
						"distinctStyl sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> styletable",
						"distinctsubcat sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> subcattable",
						"ditsinctCatg sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> catgtable",
						"distinctDept sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> depttable"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_adls')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_parquet')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_rtlloc')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_adls",
								"type": "DatasetReference"
							},
							"name": "adlsrtloc"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "regn"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "districttable"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "streettable"
						}
					],
					"transformations": [
						{
							"name": "regionselect"
						},
						{
							"name": "distinctregion"
						},
						{
							"name": "districtselect"
						},
						{
							"name": "distinctdistrict"
						},
						{
							"name": "strtselect"
						}
					],
					"scriptLines": [
						"source(output(",
						"          str as short,",
						"          str_label as string,",
						"          dstr as short,",
						"          dstr_label as string,",
						"          rgn as short,",
						"          rgn_label as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     inferDriftedColumnTypes: true,",
						"     ignoreNoFilesFound: false) ~> adlsrtloc",
						"adlsrtloc select(mapColumn(",
						"          rgn,",
						"          rgn_label",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> regionselect",
						"regionselect aggregate(groupBy(rgn),",
						"     rgn_label = first(rgn_label)) ~> distinctregion",
						"adlsrtloc select(mapColumn(",
						"          dstr,",
						"          dstr_label,",
						"          rgn",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> districtselect",
						"districtselect aggregate(groupBy(dstr),",
						"     each(match(name!='dstr'), $$ = first($$))) ~> distinctdistrict",
						"adlsrtloc select(mapColumn(",
						"          str,",
						"          str_label,",
						"          dstr",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> strtselect",
						"distinctregion sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> regn",
						"distinctdistrict sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> districttable",
						"strtselect sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> streettable"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_adls')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_parquet')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_site')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_adls",
								"type": "DatasetReference"
							},
							"name": "adlsposite"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "subchnl"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "chnltable"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference"
							},
							"name": "sitetable"
						}
					],
					"transformations": [
						{
							"name": "chnlselect"
						},
						{
							"name": "distinctchnl"
						},
						{
							"name": "subchnlselect"
						},
						{
							"name": "distinctsubchnl"
						},
						{
							"name": "siteselect"
						},
						{
							"name": "distictsite"
						}
					],
					"scriptLines": [
						"source(output(",
						"          site_id as string,",
						"          site_label as string,",
						"          subchnl_id as string,",
						"          subchnl_label as string,",
						"          chnl_id as string,",
						"          chnl_label as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     inferDriftedColumnTypes: true,",
						"     ignoreNoFilesFound: false) ~> adlsposite",
						"adlsposite select(mapColumn(",
						"          chnl_id,",
						"          chnl_label",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> chnlselect",
						"chnlselect aggregate(groupBy(chnl_id),",
						"     chnl_label = first(chnl_label)) ~> distinctchnl",
						"adlsposite select(mapColumn(",
						"          subchnl_id,",
						"          subchnl_label,",
						"          chnl_id",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> subchnlselect",
						"subchnlselect aggregate(groupBy(subchnl_id),",
						"     each(match(name!='subchnl_id'), $$ = first($$))) ~> distinctsubchnl",
						"adlsposite select(mapColumn(",
						"          site_id,",
						"          site_label,",
						"          subchnl_id",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> siteselect",
						"siteselect aggregate(groupBy(site_id),",
						"     each(match(name!='site_id'), $$ = first($$))) ~> distictsite",
						"distinctsubchnl sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> subchnl",
						"distinctchnl sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> chnltable",
						"distictsite sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> sitetable"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_adls')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_parquet')]"
			]
		},
